PORT=3000

# Cấu hình PostgreSQL (được dùng khi không khai báo DATABASE_URL)
PGHOST=localhost
PGPORT=5432
PGDATABASE=motorcycle_parts
PGUSER=postgres
PGPASSWORD=1234

# Tùy chọn: dùng chuỗi kết nối đầy đủ thay cho các biến PG*.
# DATABASE_URL=postgresql://postgres:your_database_password@localhost:5432/motorcycle_parts
# DB_SSL=true

# Danh sách origin phân cách bằng dấu phẩy; để trống cho phép mọi origin.
CORS_ORIGIN=

# Bắt buộc đặt khóa riêng trước khi truy cập /admin/.
ADMIN_API_KEY= 
